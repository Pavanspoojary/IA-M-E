{
  "version": 2,
  "rewrites": [
    { "source": "/models/(.*)", "destination": "/web/models/$1" },
    { "source": "/sample_data/(.*)", "destination": "/web/sample_data/$1" },
    { "source": "/static/(.*)", "destination": "/web/$1" },
    { "source": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|onnx|wasm|json))", "destination": "/web/$1" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}
